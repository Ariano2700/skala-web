# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca se commitea.

# Google Analytics 4 — Measurement ID (público, no es un secreto).
# En producción (Netlify) hay que configurar esta misma variable en
# Site settings → Environment variables, porque Netlify no lee el .env
# local durante el build.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Libro de Reclamaciones — el formulario público de /libro-de-reclamaciones
# NUNCA llama a Sanity directo (ni desde el navegador ni con un write token
# acá). Postea a la propia API de skala-web (src/pages/api/complaints/create.ts),
# que server-to-server reenvía a manager-skala. Ninguna de las dos variables
# lleva prefijo PUBLIC_ a propósito: solo las variables PUBLIC_* llegan al
# bundle del navegador en Astro — estas dos deben quedarse siempre del lado
# del servidor.
#
# URL base (sin slash final) del deploy de manager-skala que expone
# POST /api/public/complaints/submit.
MANAGER_SKALA_API_URL=https://manager.skalaagencia.com
# Mismo secreto que manager-skala espera en el header "x-api-key" de esa
# ruta (COMPLAINTS_SUBMIT_API_KEY en su .env). Pídeselo a quien administre
# ese proyecto — no se genera acá.
COMPLAINTS_SUBMIT_API_KEY=
