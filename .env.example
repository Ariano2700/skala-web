# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca se commitea.

# Google Analytics 4 — Measurement ID (público, no es un secreto).
# En producción (Netlify) hay que configurar esta misma variable en
# Site settings → Environment variables, porque Netlify no lee el .env
# local durante el build.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
