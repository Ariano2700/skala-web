---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import SectionLabel from "../components/landing/SectionLabel.astro";
import CtaSection from "../components/landing/CtaSection.astro";
import SinglesSection from "../components/landing/SinglesSection.astro";
import BrandsMarquee from "../components/shared/BrandsMarquee.astro";
import { FiArrowUpRight, FiPackage } from "react-icons/fi";
import { serviceCategories } from "../data/serviceCategories";
import { getOrganizationSchema, organizationRef } from "../data/organization";

const pageTitle = "Servicios y packs - Skala Agencia & Productora";
const pageDescription =
  "Packs individuales de desarrollo web, branding, diseño, fotografía, video y cobertura de eventos, más servicios sueltos con cotización directa por WhatsApp.";
const canonicalUrl = new URL(
  "/servicios/",
  Astro.site ?? new URL("https://skalaagencia.netlify.app"),
).href;
const serviciosKeywords =
  "packs de branding trujillo, diseño de logo precio, paginas web trujillo, cobertura de eventos, video corporativo, servicios de diseño redes sociales, skala servicios";

const pricedPacks = serviceCategories.flatMap((category) =>
  category.sections.flatMap((section) => section.packs),
);

// Algunos packs (ej. desarrollo web) tienen precio en rango ("S/ 450 - S/ 900")
// en vez de un valor fijo; se refleja como min/max en el JSON-LD.
const buildOffer = (pack: (typeof pricedPacks)[number]) => {
  const numbers =
    pack.price.match(/[\d,]+/g)?.map((n) => Number(n.replace(/,/g, ""))) ?? [];
  const priceFields =
    numbers.length >= 2
      ? {
          priceSpecification: {
            "@type": "PriceSpecification",
            minPrice: numbers[0],
            maxPrice: numbers[1],
            priceCurrency: "PEN",
          },
        }
      : numbers.length === 1
        ? { price: numbers[0], priceCurrency: "PEN" }
        : {};

  return {
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: pack.name,
      description: pack.tagline,
    },
    ...priceFields,
  };
};

// Precio de entrada de cada categoría, para la card del grid (el detalle de
// cada tier vive en /servicios/[categoria], no acá).
const startingPriceByCategory = new Map(
  serviceCategories.map((category) => {
    const allNumbers = category.sections
      .flatMap((section) => section.packs)
      .flatMap(
        (pack) =>
          pack.price.match(/[\d,]+/g)?.map((n) => Number(n.replace(/,/g, ""))) ?? [],
      );
    return [category.slug, Math.min(...allNumbers)];
  }),
);

const structuredData = [
  getOrganizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Branding, diseño, desarrollo web, fotografía y video",
    provider: organizationRef,
    areaServed: {
      "@type": "City",
      name: "Trujillo",
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Packs y servicios sueltos Skala",
      itemListElement: pricedPacks.map(buildOffer),
    },
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  keywords={serviciosKeywords}
  robots="index, follow"
>
  <main id="top" class="relative z-10 flex flex-col gap-24 pb-24">
    <section class="mx-auto w-full max-w-360 px-5 pt-32 md:px-12">
      <SectionLabel label="Servicios y packs" />
      <h1
        class="m-0 max-w-[18ch] font-display text-[clamp(2.4rem,4.8vw,5rem)] leading-[0.95] tracking-[-0.065em]"
        data-reveal
      >
        Todo lo que hacemos, en packs claros y con precio.
      </h1>
      <p
        class="mt-5 max-w-[62ch] text-[1.05rem] leading-8 text-skala-muted"
        data-reveal
        style="--reveal-delay: 120ms;"
      >
        Desde una web o un logo hasta una cobertura de evento: elige la
        categoría que necesitas para ver los packs, precios y alcance
        completos, o cotiza una pieza suelta directo por WhatsApp.
      </p>
    </section>

    <section class="mx-auto w-full max-w-360 px-5 md:px-12">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          serviceCategories.map((category, index) => (
            <a
              href={`/servicios/${category.slug}`}
              title={`Ver planes de ${category.navLabel}`}
              aria-label={`Ver planes de ${category.navLabel}`}
              class="group relative flex flex-col gap-5 overflow-hidden rounded-[28px] border border-skala-border bg-[linear-gradient(180deg,rgba(8,24,52,0.94),rgba(4,20,46,0.96))] p-7 shadow-(--shadow) transition duration-300 hover:-translate-y-1.5 hover:border-skala-accent/40 hover:bg-skala-accent/5"
              data-reveal
              style={`--reveal-delay: ${index * 80}ms;`}
            >
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-skala-accent/24 bg-skala-accent/8 text-skala-accent shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition-transform duration-300 group-hover:scale-110">
                <category.icon className="h-6 w-6" aria-hidden="true" />
              </div>
              <div class="flex flex-col gap-2">
                <h2 class="m-0 font-display text-[1.15rem] leading-[1.3] tracking-[-0.04em] text-skala-text">
                  {category.navLabel}
                </h2>
                <p class="m-0 line-clamp-2 text-sm leading-6 text-skala-muted">
                  {category.intro[0]}
                </p>
              </div>
              <div class="mt-auto flex items-center justify-between gap-3 pt-2">
                <span class="text-[0.66rem] uppercase tracking-[0.18em] text-skala-accent">
                  Desde S/ {startingPriceByCategory.get(category.slug)}
                </span>
                <span class="inline-flex items-center gap-1.5 text-[0.7rem] font-black uppercase tracking-[0.14em] text-skala-text">
                  Ver planes
                  <FiArrowUpRight
                    aria-hidden="true"
                    className="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </div>
            </a>
          ))
        }

        <a
          href="#sueltos"
          title="Ver servicios sueltos"
          aria-label="Ver servicios sueltos"
          class="group relative flex flex-col gap-5 overflow-hidden rounded-[28px] border border-skala-border bg-white/[0.035] p-7 shadow-(--shadow) transition duration-300 hover:-translate-y-1.5 hover:border-skala-accent/40 hover:bg-skala-accent/5"
          data-reveal
          style={`--reveal-delay: ${serviceCategories.length * 80}ms;`}
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-skala-accent/24 bg-skala-accent/8 text-skala-accent shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition-transform duration-300 group-hover:scale-110">
            <FiPackage className="h-6 w-6" aria-hidden="true" />
          </div>
          <div class="flex flex-col gap-2">
            <h2 class="m-0 font-display text-[1.15rem] leading-[1.3] tracking-[-0.04em] text-skala-text">
              Servicios Sueltos
            </h2>
            <p class="m-0 line-clamp-2 text-sm leading-6 text-skala-muted">
              Piezas individuales sin compromiso mensual, a cotizar directo por
              WhatsApp.
            </p>
          </div>
          <div class="mt-auto flex items-center justify-between gap-3 pt-2">
            <span class="text-[0.66rem] uppercase tracking-[0.18em] text-skala-accent">
              A cotizar
            </span>
            <span class="inline-flex items-center gap-1.5 text-[0.7rem] font-black uppercase tracking-[0.14em] text-skala-text">
              Ver servicios
              <FiArrowUpRight
                aria-hidden="true"
                className="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </span>
          </div>
        </a>
      </div>
    </section>

    <SinglesSection />

    <BrandsMarquee />

    <CtaSection />
  </main>
</Layout>
