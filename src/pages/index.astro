---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import AboutSection from "../components/landing/AboutSection.astro";
import ContactSection from "../components/landing/ContactSection.astro";
import CtaSection from "../components/landing/CtaSection.astro";
import FaqTeaser from "../components/landing/faq/FaqTeaser.astro";
import HeroOverlapReveal from "../components/landing/HeroOverlapReveal.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import MarqueeStrip from "../components/landing/MarqueeStrip.astro";
import BrandsMarquee from "../components/shared/BrandsMarquee.astro";
import MoreServicesCta from "../components/landing/MoreServicesCta.astro";
import PlansSection from "../components/landing/PlansSection.astro";
import ProcessSection from "../components/landing/ProcessSection.astro";
import ServicesSection from "../components/landing/ServicesSection.astro";
import Team from "../components/landing/team/Team.astro";
import {
  getOrganizationWithTeamSchema,
  organizationRef,
} from "../data/organization";
const pageTitle = "Skala - Agencia de Branding & Producción Audiovisual";
const pageDescription =
  "Agencia estratégica en Trujillo, Perú. Especialistas en diseño de marca, fotografía comercial, producción de video para redes sociales y campañas integrales.";
const canonicalUrl = (Astro.site ?? new URL("https://skalaagencia.netlify.app"))
  .href;
const homeKeywords =
  "agencia de publicidad trujillo, productora audiovisual peru, diseño de marca, marketing digital trujillo, produccion de video, creacion de contenido, escala agencia, skala";
const homeStructuredData = [
  getOrganizationWithTeamSchema(),
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Skala Agencia",
    url: canonicalUrl,
    publisher: organizationRef,
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={homeStructuredData}
  keywords={homeKeywords}
  robots="index, follow"
>
  <main class="relative z-10">
    <HeroSection />
    <div class="hero-overlap-wrapper" data-hero-overlap-wrapper>
      <BrandsMarquee overlap />
      <MarqueeStrip />
      <AboutSection />
      <ServicesSection />
      <PlansSection />
      <MoreServicesCta />
      <ProcessSection />
      <Team />
      <ContactSection />
      <FaqTeaser />
      <CtaSection />
    </div>
    <HeroOverlapReveal />
  </main>
</Layout>

<style>
  /*
    HeroOverlapReveal.astro le da a este wrapper un translateY constante
    (== alto del hero) para que BrandsMarquee arranque oculto bajo el
    viewport y el scroll nativo lo revele al subir — moviendo el wrapper
    completo (no sólo BrandsMarquee) se evita que quede un hueco entre
    BrandsMarquee y las secciones que le siguen.
  */
  .hero-overlap-wrapper {
    position: relative;
    z-index: 2;
    /*
      --hero-overlap-offset la fija un script en <head> (Layout.astro) antes
      de que este nodo exista, así ya nace en su posición final — el
      fallback 0px es lo correcto para prefers-reduced-motion (donde ese
      script no la fija) y para el instante antes de que corra cualquier
      script. HeroOverlapReveal.astro toma el control de esta misma
      transformación (gsap.set con el mismo valor) una vez que crea el
      efecto de scroll.
    */
    transform: translateY(var(--hero-overlap-offset, 0px));
  }
</style>
