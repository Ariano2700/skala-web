---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import SectionLabel from "../components/landing/SectionLabel.astro";
import Team from "../components/landing/team/Team.astro";
import CtaSection from "../components/landing/CtaSection.astro";
import BrandsMarquee from "../components/shared/BrandsMarquee.astro";
import { getOrganizationWithTeamSchema } from "../data/organization";
import {
  FiCompass,
  FiFilm,
  FiMessageCircle,
  FiTrendingUp,
  FiArrowUpRight,
} from "react-icons/fi";

const pageTitle = "Sobre Nosotros | Skala Agencia & Productora en Trujillo";
const pageDescription =
  "Conoce a Skala: agencia y productora en Trujillo que junta estrategia de marca, diseño y producción audiovisual en un mismo equipo, sin subcontratar el trabajo creativo.";
const canonicalUrl = new URL(
  "/nosotros/",
  Astro.site ?? new URL("https://skalaagencia.netlify.app"),
).href;
const keywords =
  "sobre skala, agencia de branding trujillo, productora audiovisual trujillo, equipo skala, quienes somos skala";

const structuredData = [getOrganizationWithTeamSchema()];

const values = [
  {
    icon: FiCompass,
    title: "Estrategia antes que estética",
    description:
      "Ninguna pieza sale sin responder primero a un objetivo de marca. El diseño y la producción vienen después, no al revés.",
  },
  {
    icon: FiFilm,
    title: "Producción propia, sin subcontratar",
    description:
      "Rodaje, edición, diseño y estrategia los cubre el mismo equipo interno — no tercerizamos el trabajo creativo a freelancers sueltos.",
  },
  {
    icon: FiMessageCircle,
    title: "Comunicación directa",
    description:
      "Hablas con quien hace el trabajo, por WhatsApp, sin pasar por capas de account managers que solo trasladan mensajes.",
  },
  {
    icon: FiTrendingUp,
    title: "Resultados medibles",
    description:
      "Cada entrega apunta a un indicador real (alcance, leads, ventas), no solo a que la pieza se vea bien en el portafolio.",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  keywords={keywords}
  robots="index, follow"
>
  <main class="relative z-10">
    <section
      class="mx-auto grid w-full max-w-360 gap-14 px-5 pt-32 pb-20 md:px-12 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] xl:items-center"
    >
      <div class="flex flex-col gap-6">
        <SectionLabel label="Sobre Skala" />
        <h1
          class="m-0 max-w-[14ch] font-display text-[clamp(2.6rem,5.4vw,4.8rem)] font-black leading-[0.95] tracking-[-0.06em]"
          data-reveal
          style="--reveal-delay: 90ms;"
        >
          Un equipo, no una lista de proveedores sueltos.
        </h1>
        <p
          class="max-w-[54ch] text-[1.05rem] leading-8 text-skala-muted"
          data-reveal
          style="--reveal-delay: 160ms;"
        >
          Skala nace en Trujillo con una idea simple: una marca no crece con
          un diseñador por un lado, un camarógrafo por otro y un community
          manager improvisando en medio. Crece cuando estrategia, identidad y
          producción responden al mismo criterio, en el mismo equipo.
        </p>
        <p
          class="max-w-[54ch] leading-8 text-skala-muted"
          data-reveal
          style="--reveal-delay: 220ms;"
        >
          Somos un estudio joven, construyendo caso a caso — con clientes
          reales en Trujillo y La Libertad — el catálogo de servicios que hoy
          ves en el sitio. Preferimos crecer sobre resultados verificables
          antes que sobre promesas grandes.
        </p>
      </div>

      <div
        class="grid grid-cols-1 gap-4 sm:grid-cols-2"
        data-reveal
        style="--reveal-delay: 260ms;"
      >
        {
          values.map((value, index) => (
            <article
              class="group flex flex-col gap-4 rounded-[28px] border border-skala-border bg-[linear-gradient(180deg,rgba(8,24,52,0.94),rgba(4,20,46,0.96))] p-6 shadow-(--shadow) transition duration-300 hover:-translate-y-1 hover:border-skala-accent/40 hover:bg-skala-accent/5"
              style={`--reveal-delay: ${index * 90}ms;`}
            >
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-skala-accent/24 bg-skala-accent/8 text-skala-accent shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition-transform duration-300 group-hover:scale-110">
                <value.icon className="h-5 w-5" aria-hidden="true" />
              </div>
              <h3 class="m-0 font-display text-[0.95rem] leading-[1.4] tracking-[-0.04em] text-skala-text">
                {value.title}
              </h3>
              <p class="m-0 leading-7 text-skala-muted">{value.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="mx-auto w-full max-w-360 px-5 pb-8 md:px-12"
      aria-labelledby="proceso-teaser-title"
    >
      <div
        class="flex flex-col items-start justify-between gap-6 rounded-4xl border border-skala-border bg-white/[0.035] p-8 shadow-(--shadow) md:flex-row md:items-center md:p-10"
        data-reveal
      >
        <div>
          <p class="m-0 text-[0.68rem] uppercase tracking-[0.22em] text-skala-accent">
            Cómo trabajamos
          </p>
          <h2
            id="proceso-teaser-title"
            class="mt-3 max-w-[24ch] font-display text-[clamp(1.6rem,2.6vw,2.2rem)] font-black leading-[1.05] tracking-[-0.045em] text-skala-text"
          >
            Del brief al resultado en cinco pasos con ritmo de producción.
          </h2>
        </div>
        <a
          href="/#proceso"
          title="Ver el proceso completo"
          aria-label="Ver el proceso completo"
          class="group inline-flex shrink-0 items-center justify-center gap-3 rounded-full border border-skala-border-strong bg-white/3 px-6 py-4 font-display text-[0.74rem] uppercase tracking-[0.16em] text-skala-text shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] transition duration-200 hover:-translate-y-0.5 hover:scale-[1.015] hover:border-skala-accent/40 hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-y-px"
        >
          <span>Ver el proceso completo</span>
          <FiArrowUpRight
            aria-hidden="true"
            className="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>
    </section>

    <Team />
    <BrandsMarquee />
    <CtaSection />
  </main>
</Layout>
