---
import Layout from "../../layouts/Layout.astro";
import EventCta from "../../components/event/EventCta.astro";
import EventDetailHero from "../../components/event/EventDetailHero.astro";
import EventClient from "../../components/event/EventClient.astro";
import { formatEventDate } from "../../data/event";
import { getEventBySlug } from "../../sanity/event/api";
import EventGallery from "../../components/event/EventGallery";
import BrandsMarquee from "../../components/shared/BrandsMarquee.astro";

// SSR bajo demanda (sin `prerender = true`, hereda el `output: "server"` de
// astro.config.mjs): cada visita consulta Sanity en vivo (`getEventBySlug`),
// no un HTML pre-generado en build. Se eligió así para no tener que
// redeployar el sitio cada vez que se publica, edita o borra un evento en
// Sanity — un cambio en el CMS se ve en la siguiente visita, sin build.
// Contrapartida: cada visita paga el round-trip a Sanity (el proyecto no usa
// su CDN — `useCdn: false` en astro.config.mjs — para leer siempre el
// dataset "production" sin la latencia de invalidación de esa caché).
const { slug } = Astro.params;
const event = await getEventBySlug(slug as string);

if (!event) {
  return Astro.redirect("/cobertura-eventos/", 302);
}

const pageTitle = event.seo?.metaTitle || `${event.title} | Eventos Skala`;
const pageDescription =
  event.seo?.metaDescription ||
  event.hero.description ||
  `Cobertura fotográfica y audiovisual del evento ${event.title}, realizado ${formatEventDate(
    event,
  )}${event.location?.venue ? ` en ${event.location.venue}` : ""}.`;
const canonicalUrl = new URL(
  `/cobertura-eventos/${event.slug}/`,
  Astro.site ?? new URL("https://skalaagencia.netlify.app"),
).href;
const ogImage =
  event.seo?.ogImageUrl ||
  event.hero.imageUrl ||
  new URL("/logotype.jpg", Astro.site ?? "https://skalaagencia.netlify.app")
    .href;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Event",
    name: event.title,
    startDate: event.date,
    ...(event.endDate ? { endDate: event.endDate } : {}),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    description: pageDescription,
    image: [ogImage],
    url: canonicalUrl,
    ...(event.location?.venue
      ? {
          location: {
            "@type": "Place",
            name: event.location.venue,
            address: event.location.address || undefined,
            ...(event.location.geo
              ? {
                  geo: {
                    "@type": "GeoCoordinates",
                    latitude: event.location.geo.lat,
                    longitude: event.location.geo.lng,
                  },
                }
              : {}),
          },
        }
      : {}),
    organizer: {
      "@type": "Organization",
      name: "Skala",
      url: "https://skalaagencia.netlify.app",
    },
  },
];
const GALLERY_PAGE_SIZE = 8;
const galleryFirstPage = event.gallery.slice(0, GALLERY_PAGE_SIZE);
---

<Layout
  title={pageTitle + " | Skala"}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  robots="index, follow"
>
  <main id="top" class="relative z-10">
    <EventDetailHero event={event} />
    {event.clients.length > 0 && <EventClient clients={event.clients} />}
    <EventGallery
      client:load
      gallery={galleryFirstPage}
      total={event.gallery.length}
      eventSlug={event.slug}
      title={event.title}
    />
    <BrandsMarquee />
    <EventCta />
  </main>
</Layout>
