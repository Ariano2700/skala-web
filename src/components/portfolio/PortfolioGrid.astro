---
import { type PortfolioProjectItem } from "../../data/portafolio";
import PortfolioGridClient from "./PortfolioGridClient";

interface Props {
  /** Primer lote, ya filtrado por `initialCategory` y recortado a `pageSize`. */
  initialItems: PortfolioProjectItem[];
  /** Total real de proyectos en `initialCategory` (no solo los de este lote). */
  initialTotal: number;
  /** Categoría activa al cargar, leída de `?categoria=` en el server. */
  initialCategory: string;
  pageSize: number;
}

const { initialItems, initialTotal, initialCategory, pageSize } = Astro.props;
---

<!--
  Sin data-reveal en la sección: cada tarjeta se revela sola, por su
  propia visibilidad (.portfolio-card-reveal, un IntersectionObserver por
  tarjeta — ver PortfolioGridClient.tsx + global.css), no cuando la grilla
  completa entra en pantalla. Así la primera tanda anima en cascada al
  scrollear hasta ella, y las tandas que trae después el scroll infinito
  (o un cambio de filtro) hacen lo mismo apenas se agregan al DOM, en vez
  de esperar a que toda la grilla ya se haya visto una vez.
-->
<section
  id="portfolio-grid"
  class="relative z-10 mx-auto w-full max-w-360 px-5 pb-28 pt-12 md:px-12"
  aria-labelledby="portfolio-grid-title"
>
  <h2 id="portfolio-grid-title" class="sr-only">Proyectos de portafolio</h2>

  <PortfolioGridClient
    client:load
    initialItems={initialItems}
    initialTotal={initialTotal}
    initialCategory={initialCategory}
    pageSize={pageSize}
  />
</section>

<style>
  .portfolio-filter.is-active {
    border-color: rgba(92, 216, 252, 1);
    background: rgba(92, 216, 252, 1);
    color: #04142e;
  }
</style>
