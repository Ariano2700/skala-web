---
// Proyectos relacionados al final del detalle: prioriza los que comparten
// categoría con el actual y completa con el resto si hace falta, para que
// la sección nunca quede vacía ni se repita el layout de tarjeta de la
// grilla principal (esta usa portada 4:3, no cuadrada).
import { FiArrowUpRight } from "react-icons/fi";
import {
  getCoverMedia,
  getPortfolioAccentStyle,
  type PortfolioProjectItem,
} from "../../data/portafolio";

interface Props {
  projects: PortfolioProjectItem[];
  current: PortfolioProjectItem;
  limit?: number;
}

const { projects, current, limit = 3 } = Astro.props as Props;

const others = projects.filter((p) => p.id !== current.id);
const shared = others.filter((p) =>
  p.categories.some((c) => current.categories.includes(c)),
);
const rest = others.filter((p) => !shared.includes(p));
const related = [...shared, ...rest].slice(0, limit);
---

{
  related.length > 0 && (
    <section
      class="relative z-10 mx-auto w-full max-w-360 px-5 pb-4 md:px-12"
      aria-labelledby="related-projects-title"
    >
      <h2
        id="related-projects-title"
        class="m-0 mb-8 font-display text-2xl font-black tracking-[-0.04em] text-skala-text md:text-3xl"
        data-reveal="fade"
      >
        Más proyectos
      </h2>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((project, index) => {
          const cover = getCoverMedia(project);
          const accentStyle = getPortfolioAccentStyle(project);
          return (
            <a
              href={`/proyecto/${project.id}/`}
              class="group relative flex flex-col overflow-hidden rounded-3xl border border-skala-border bg-[#0c1730] transition duration-300 hover:-translate-y-1 hover:border-skala-accent/35 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-skala-accent/70"
              aria-label={`Ver proyecto: ${project.title}`}
              data-reveal="scale"
              style={`--reveal-delay: ${index * 90}ms;`}
            >
              <div class="relative aspect-4/3 overflow-hidden bg-skala-surface">
                {cover.type === "image" ? (
                  <img
                    src={cover.src}
                    alt={cover.alt ?? project.title}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full scale-100 object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <video
                    src={cover.src}
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    class="absolute inset-0 h-full w-full scale-100 object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                )}
                <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,22,0)_55%,rgba(6,10,22,0.85)_100%)]" />
                <span
                  class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-black/45 px-3 py-1 text-[0.62rem] font-black uppercase tracking-[0.14em] text-skala-text"
                >
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={accentStyle} />
                  {project.categoryLabel}
                </span>
              </div>

              <div class="flex items-center justify-between gap-3 p-5">
                <div class="min-w-0">
                  <h3 class="m-0 truncate font-display text-lg font-black tracking-[-0.03em] text-skala-text">
                    {project.title}
                  </h3>
                  <p class="m-0 truncate text-sm text-skala-muted">{project.client}</p>
                </div>
                <FiArrowUpRight
                  className="h-4 w-4 shrink-0 text-skala-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  aria-hidden="true"
                />
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )
}
