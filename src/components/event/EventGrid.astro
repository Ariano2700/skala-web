---
import { BsSearch } from "react-icons/bs";
import EventCard from "./EventCard.astro";
import type { Event } from "../../sanity/event/event-mapper";

interface Props {
  events?: Event[];
}

const { events = [] } = Astro.props;
---

<section
  id="eventos-grid"
  class="relative z-10 mx-auto w-full max-w-360 px-5 pb-28 pt-12 md:px-12"
  aria-labelledby="eventos-grid-title"
>
  <h2 id="eventos-grid-title" class="sr-only">Listado de eventos</h2>

  <div class="event-grid grid grid-cols-12 gap-4" data-event-grid>
    {events.map((event, index) => <EventCard event={event} index={index} />)}
  </div>

  <div
    id="event-empty"
    class="hidden rounded-3xl border border-skala-border bg-white/[0.035] p-12 text-center"
    data-event-empty
  >
    <p
      class="mb-3 font-display text-4xl font-black tracking-[-0.04em] text-skala-text"
    >
      <BsSearch className="mx-auto mb-6 h-12 w-12 text-skala-accent" />
    </p>
    <h3
      class="mb-3 font-display text-2xl font-black tracking-[-0.04em] text-skala-text"
      data-empty-title
    >
      No hay eventos coberturados todavia.
    </h3>
    <p class="m-0 text-sm leading-7 text-skala-muted" data-empty-message>
      Estamos trabajando para ofrecerte la mejor cobertura de eventos. Pronto podrás verlos aquí.
    </p>
  </div>
</section>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLAnchorElement>(".event-filter");
  const grid = document.querySelector<HTMLElement>("[data-event-grid]");
  const empty = document.querySelector<HTMLElement>("[data-event-empty]");
  const emptyTitle = document.querySelector<HTMLElement>("[data-empty-title]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-empty-message]");
  const count = document.querySelector<HTMLElement>("[data-filter-count]");
  const cards = grid?.querySelectorAll<HTMLElement>("[data-event-card]");

  const hasInitialEvents = cards && cards.length > 0;

  const pluralize = (amount: number) =>
    `${amount} evento${amount !== 1 ? "s" : ""}`;

  const updateEmptyState = (visible: number, isFilterActive: boolean) => {
    if (!emptyTitle || !emptyMessage) return;
    
    if (hasInitialEvents) {
      // There are events but filter yielded no results
      emptyTitle.textContent = isFilterActive 
        ? "No hay eventos que coincidan con el filtro seleccionado."
        : "No hay eventos coberturados todavia.";
      emptyMessage.textContent = isFilterActive
        ? "Intenta seleccionar otra categoría o quitar el filtro para ver más eventos."
        : "Estamos trabajando para ofrecerte la mejor cobertura de eventos. Pronto podrás verlos aquí.";
    } else {
      // No events at all
      emptyTitle.textContent = "No hay eventos coberturados todavia.";
      emptyMessage.textContent = "Estamos trabajando para ofrecerte la mejor cobertura de eventos. Pronto podrás verlos aquí.";
    }
  };

  const applyFilter = (filter: string, button: HTMLAnchorElement) => {
    if (!grid || !cards || !empty || !count) return;

    let visible = 0;

    filterButtons.forEach((item) => {
      const isActive = item === button;
      item.setAttribute("aria-pressed", String(isActive));
      item.classList.toggle("is-active", isActive);
    });

    const isMobile = window.innerWidth < 768;
    const delayStep = isMobile ? 0.015 : 0.04;

    cards.forEach((card) => {
      const cardCategories = (card.dataset.category ?? "").split(" ");
      const matches = filter === "all" || cardCategories.includes(filter);

      if (matches) {
        card.hidden = false;
        card.classList.remove("event-card-hiding");
        // El shorthand "animation" expande a todos sus longhand (incluido
        // animation-delay) dentro del mismo inline style: si el delay se
        // asigna antes de "none"/"" queda pisado. Por eso va después, ya
        // reseteada la animación, en el mismo frame (sin pintar de por
        // medio) para que sí se respete el stagger.
        card.style.animation = "none";
        requestAnimationFrame(() => {
          card.style.animation = "";
          card.style.animationDelay = `${visible * delayStep}s`;
        });
        visible += 1;
      } else {
        card.hidden = true;
      }
    });

    const isFilterActive = filter !== "all";
    empty.classList.toggle("hidden", visible !== 0);
    updateEmptyState(visible, isFilterActive);
    count.textContent = pluralize(visible);
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      const filter = button.dataset.filter ?? "all";
      applyFilter(filter, button);
      // Refleja el filtro en la URL (?categoria=) sin recargar la página.
      const url = new URL(window.location.href);
      if (filter === "all") {
        url.searchParams.delete("categoria");
      } else {
        url.searchParams.set("categoria", filter);
      }
      window.history.replaceState({}, "", url);
    });
  });

  // Aplica el filtro activo desde el query param ?categoria= al cargar.
  const initialFilter = new URL(window.location.href).searchParams.get(
    "categoria",
  );
  if (initialFilter) {
    const activeButton = Array.from(filterButtons).find(
      (b) => b.dataset.filter === initialFilter,
    );
    if (activeButton) applyFilter(initialFilter, activeButton);
  }

  // .event-card corre por CSS animation (arranca sola al pintar), pero si
  // la grilla está debajo del pliegue esa animación ya terminó mucho antes
  // de que el usuario llegue a verla scrolleando — no se nota nada. Se
  // pausa por defecto (ver <style> de acá abajo) y recién corre cuando la
  // sección entra en pantalla.
  const eventsSection = document.getElementById("eventos-grid");
  if (eventsSection) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      eventsSection.classList.add("in-view");
    } else {
      const gridObserver = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            eventsSection.classList.add("in-view");
            currentObserver.disconnect();
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -10% 0px" },
      );
      gridObserver.observe(eventsSection);
    }
  }
</script>

<style>
  .event-card[hidden] {
    display: none;
  }

  /*
    El play-state (según #eventos-grid.in-view) vive en global.css sin
    scopear, no acá: EventCard.astro es un componente hijo, así que una
    regla scopeada en el <style> de EventGrid.astro nunca llega a las
    tarjetas que ese hijo renderiza — el scope de Astro sólo cubre
    elementos del propio template del archivo.
  */
</style>
