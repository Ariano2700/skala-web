---
import { BsSearch } from "react-icons/bs";
import EventCard from "./EventCard.astro";
import type { Event } from "../../sanity/event/event-mapper";

interface Props {
  events?: Event[];
}

const { events = [] } = Astro.props;
---

<section
  id="eventos-grid"
  class="relative z-10 mx-auto w-full max-w-360 px-5 pb-28 pt-12 md:px-12"
  aria-labelledby="eventos-grid-title"
>
  <h2 id="eventos-grid-title" class="sr-only">Listado de eventos</h2>

  <div class="event-grid grid grid-cols-12 gap-4" data-event-grid>
    {events.map((event, index) => <EventCard event={event} index={index} />)}
  </div>

  <div
    id="event-empty"
    class={events.length === 0 ? "rounded-3xl border border-skala-border bg-white/[0.035] p-12 text-center" : "hidden rounded-3xl border border-skala-border bg-white/[0.035] p-12 text-center"}
    data-event-empty
  >
    <p
      class="mb-3 font-display text-4xl font-black tracking-[-0.04em] text-skala-text"
    >
      <BsSearch className="mx-auto mb-6 h-12 w-12 text-skala-accent" />
    </p>
    <h3
      class="mb-3 font-display text-2xl font-black tracking-[-0.04em] text-skala-text"
    >
    {
      events.length === 0
        ? "No hay eventos coberturados todavia."
        : "No hay eventos que coincidan con el filtro seleccionado."
    }
    </h3>
    <p class="m-0 text-sm leading-7 text-skala-muted">
      {
        events.length === 0
          ? "Estamos trabajando para ofrecerte la mejor cobertura de eventos. Pronto podrás verlos aquí."
          : "Intenta seleccionar otra categoría o quitar el filtro para ver más eventos." 
      }
    </p>
  </div>
</section>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLAnchorElement>(".event-filter");
  const grid = document.querySelector<HTMLElement>("[data-event-grid]");
  const empty = document.querySelector<HTMLElement>("[data-event-empty]");
  const count = document.querySelector<HTMLElement>("[data-filter-count]");
  const cards = grid?.querySelectorAll<HTMLElement>("[data-event-card]");

  const pluralize = (amount: number) =>
    `${amount} evento${amount !== 1 ? "s" : ""}`;

  const applyFilter = (filter: string, button: HTMLAnchorElement) => {
    if (!grid || !cards || !empty || !count) return;

    let visible = 0;

    filterButtons.forEach((item) => {
      const isActive = item === button;
      item.setAttribute("aria-pressed", String(isActive));
      item.classList.toggle("is-active", isActive);
    });

    const isMobile = window.innerWidth < 768;
    const delayStep = isMobile ? 0.015 : 0.04;

    cards.forEach((card) => {
      const cardCategories = (card.dataset.category ?? "").split(" ");
      const matches = filter === "all" || cardCategories.includes(filter);

      if (matches) {
        card.hidden = false;
        card.classList.remove("event-card-hiding");
        card.style.animationDelay = `${visible * delayStep}s`;
        card.style.animation = "none";
        requestAnimationFrame(() => {
          card.style.animation = "";
        });
        visible += 1;
      } else {
        card.hidden = true;
      }
    });

    empty.classList.toggle("hidden", visible !== 0);
    count.textContent = pluralize(visible);
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      const filter = button.dataset.filter ?? "all";
      applyFilter(filter, button);
      // Refleja el filtro en la URL (?categoria=) sin recargar la página.
      const url = new URL(window.location.href);
      if (filter === "all") {
        url.searchParams.delete("categoria");
      } else {
        url.searchParams.set("categoria", filter);
      }
      window.history.replaceState({}, "", url);
    });
  });

  // Aplica el filtro activo desde el query param ?categoria= al cargar.
  const initialFilter = new URL(window.location.href).searchParams.get(
    "categoria",
  );
  if (initialFilter) {
    const activeButton = Array.from(filterButtons).find(
      (b) => b.dataset.filter === initialFilter,
    );
    if (activeButton) applyFilter(initialFilter, activeButton);
  }
</script>

<style>
  .event-card[hidden] {
    display: none;
  }
</style>
