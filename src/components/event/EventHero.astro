---
import { isUpcoming } from "../../data/event";
import type { Event } from "../../sanity/event/event-mapper";
import SectionLabel from "../landing/SectionLabel.astro";

interface Props {
  events?: Event[];
}

const { events = [] } = Astro.props;

const totalEvents = events.length;
const upcomingEvents = events.filter(isUpcoming).length;
const disciplines = new Set(
  events.flatMap((e) => e.categories.map((cat) => cat.slug)),
).size;
const totalImages = events.reduce((acc, e) => acc + e.stats.totalImages, 0);
---

<section id="eventos" class="relative z-10 overflow-hidden py-20 md:py-36">
  <div class="mx-auto max-w-360 px-5 md:px-12">
    <div class="relative grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
      <div data-reveal>
        <SectionLabel label="Eventos" />
        <h1
          class="m-0 max-w-[14ch] font-display text-[clamp(3.4rem,7vw,7.7rem)] font-black leading-[0.88] tracking-[-0.065em] text-skala-text text-wrap:balance"
        >
          El evento termina. El contenido, no.
        </h1>
      </div>

      <div
        class="relative flex flex-col gap-6"
        data-reveal
        style="--reveal-delay: 120ms;"
      >
        <div
          class="relative overflow-hidden rounded-4xl border border-skala-border shadow-[0_24px_70px_rgba(0,22,52,0.28)]"
        >
          <img
            src="/event/hero_event.JPG"
            alt="Cobertura en vivo de un evento producido por Skala"
            loading="eager"
            fetchpriority="high"
            class="aspect-4/3 w-full object-cover md:aspect-16/10"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-[#04142e]/85 via-[#04142e]/5 to-transparent"
          >
          </div>
          <span
            class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-[#04142e]/70 px-4 py-2 text-[0.65rem] font-black uppercase tracking-[0.14em] text-skala-text backdrop-blur"
          >
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-skala-accent"></span>
            En vivo
          </span>
        </div>

        <div class="flex flex-col gap-4">
          <p
            class="relative z-10 m-0 max-w-[58ch] text-base leading-8 text-skala-muted md:text-lg"
          >
            Convertimos cada lanzamiento y activación en contenido que sigue
            generando marca mucho después de que se apagan las luces:
            cobertura fotográfica y audiovisual en vivo, lista para redes en
            minutos.
          </p>

          <div
            class="relative z-10 mt-8 grid grid-cols-2 gap-3 rounded-4xl border border-skala-border bg-white/[0.035] p-5 shadow-[0_24px_70px_rgba(0,22,52,0.22)] md:grid-cols-4"
            aria-label="Resumen de eventos"
          >
            <div>
              <p
                class="font-display text-3xl font-black tracking-[-0.06em] text-skala-text"
              >
                {totalEvents}
              </p>
              <p class="text-xs uppercase tracking-[0.16em] text-skala-muted">
                Eventos
              </p>
            </div>
            <div>
              <p
                class="font-display text-3xl font-black tracking-[-0.06em] text-skala-text"
              >
                {upcomingEvents}
              </p>
              <p class="text-xs uppercase tracking-[0.16em] text-skala-muted">
                Próximos
              </p>
            </div>
            <div>
              <p
                class="font-display text-3xl font-black tracking-[-0.06em] text-skala-text"
              >
                {disciplines}
              </p>
              <p class="text-xs uppercase tracking-[0.16em] text-skala-muted">
                Disciplinas
              </p>
            </div>
            <div>
              <p
                class="font-display text-3xl font-black tracking-[-0.06em] text-skala-text"
              >
                {totalImages}
              </p>
              <p class="text-xs uppercase tracking-[0.16em] text-skala-muted">
                Imágenes
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-skala-border/80 pt-8 md:flex-row md:items-center md:justify-between"
      data-reveal
      style="--reveal-delay: 180ms;"
    >
      <div class="flex flex-wrap gap-3">
        <span
          class="inline-flex items-center rounded-full border border-skala-accent/35 bg-skala-accent/10 px-4 py-2 text-[0.72rem] font-black uppercase tracking-[0.16em] text-skala-text"
        >
          {totalEvents} eventos
        </span>
        <span
          class="inline-flex items-center rounded-full border border-skala-border px-4 py-2 text-[0.72rem] font-bold uppercase tracking-[0.16em] text-skala-muted"
        >
          Cobertura en vivo
        </span>
      </div>

      <p class="m-0 text-sm text-skala-muted">
        Explora cada cobertura y filtra por disciplina para ver el detrás de
        cámaras.
      </p>
    </div>
  </div>
</section>