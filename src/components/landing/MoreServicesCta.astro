---
import { FiArrowUpRight, FiCompass } from "react-icons/fi";
---

<section class="mx-auto w-full max-w-360 px-5 md:px-12">
  <div
    class="group relative flex flex-col items-start gap-5 overflow-hidden rounded-[30px] border border-skala-border bg-[linear-gradient(180deg,rgba(8,24,52,0.72),rgba(4,20,46,0.86))] p-8 shadow-(--shadow) transition duration-300 hover:border-skala-accent/35 hover:bg-skala-accent/4 sm:flex-row sm:items-center sm:justify-between"
    data-reveal
  >
    <div class="flex items-center gap-4">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-skala-accent/24 bg-skala-accent/8 text-skala-accent">
        <FiCompass className="h-6 w-6" aria-hidden="true" />
      </span>
      <div>
        <h3 class="m-0 font-display text-[1.15rem] font-black tracking-[-0.03em] text-skala-text">
          ¿Buscas algo más puntual?
        </h3>
        <p class="m-0 mt-1 text-sm leading-6 text-skala-muted">
          Branding, diseño, fotografía, video o una web: mira todos los packs y
          servicios sueltos disponibles.
        </p>
      </div>
    </div>

    <a
      href="/servicios"
      title="Ver todos los servicios"
      aria-label="Ver todos los servicios"
      class="group/link inline-flex shrink-0 items-center gap-2 rounded-full border border-skala-border bg-skala-surface px-6 py-3.5 text-[0.72rem] font-black uppercase tracking-[0.16em] text-skala-text transition duration-200 hover:-translate-y-0.5 hover:border-skala-accent/40 hover:bg-skala-accent/8 focus-visible:ring-2 focus-visible:ring-skala-accent/60"
    >
      Ver servicios
      <FiArrowUpRight
        aria-hidden="true"
        className="transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
      />
    </a>
  </div>
</section>
