---
// Un panel por cluster, todos en el DOM desde el server (progresivo: sin
// JS, el primer cluster ya se ve y funciona vía <details> nativo). El
// script de FaqSection.astro alterna el atributo `hidden` al cambiar de
// tab — nunca inyecta ni destruye contenido, así que las 26 respuestas
// siguen siendo texto real y crawlable aunque su panel no esté visible.
import type { FaqCluster } from "../../../data/faq";
import FaqItem from "./FaqItem.astro";

interface Props {
  clusters: FaqCluster[];
  activeId: string;
}

const { clusters, activeId } = Astro.props;
---

{
  /*
    Los paneles se apilan en la misma celda de grid (col/row-start-1) a
    propósito: así el saliente y el entrante pueden coexistir visibles un
    instante durante el crossfade (ver script en FaqSection.astro) sin que
    el layout salte, en vez de que uno desaparezca antes de que el otro
    ocupe su lugar.
  */
}
<div class="relative grid">
  {
    clusters.map((cluster) => (
      <div
        class="faq-panel col-start-1 row-start-1 mx-auto flex max-w-215 flex-col gap-3"
        data-faq-panel={cluster.id}
        hidden={cluster.id !== activeId}
      >
        {cluster.items.map((item, index) => (
          <FaqItem
            q={item.q}
            a={item.a}
            defaultOpen={index === 0}
            index={index}
            name={`faq-${cluster.id}`}
          />
        ))}
      </div>
    ))
  }
</div>
