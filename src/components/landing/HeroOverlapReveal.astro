---
// Sólo se usa en la portada, justo después de <HeroSection /> + el wrapper
// data-hero-overlap-wrapper (BrandsMarquee overlap + el resto de secciones).
//
// Efecto: al bajar el scroll, el hero se queda fijo un viewport de alto
// mientras se desvanece/encoge, y el wrapper siguiente sube y lo cubre —
// empezando por BrandsMarquee, que ya lleva su look de "tarjeta" (ver el
// <style> de BrandsMarquee.astro).
//
// Antes esto era un pin de ScrollTrigger (pin:true + pinSpacing + un
// translateY(-innerHeight) en el wrapper). En mobile daba tirones: el pin
// alterna el hero entre relative y fixed desde JS, un frame por detrás del
// scroll nativo (que corre en otro hilo), e innerHeight cambia cada vez
// que la barra del navegador se muestra/oculta, así que todo se recalculaba
// y saltaba. Ahora:
//   - el "quedarse fijo" lo hace CSS (position: sticky, ver .is-hero-sticky
//     en HeroSection.astro), resuelto por el compositor: cero saltos. El
//     wrapper ya viene justo después del hero en el flujo normal, así que
//     sube y lo tapa solo, sin translateY ni espacio reservado.
//   - GSAP sólo scrubea el fundido (opacity/scale/y) del hero, igual que
//     antes. El trigger es el WRAPPER (no el hero, que al estar sticky no
//     se mueve y daría medidas falsas): de "top bottom" (asoma por abajo,
//     == el hero se pega) a "top top" (lo cubrió entero, == fin del pin
//     anterior). Mismo tramo de scroll que el pin de antes.
---

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero-pin]");
  const overlapWrapper = document.querySelector<HTMLElement>(
    "[data-hero-overlap-wrapper]",
  );

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (hero && overlapWrapper && !reduceMotion) {
    // El alto real del hero define dónde se pega (top: 100svh - alto). Se
    // mide con ResizeObserver: cubre el cambio de fuente (Unbounded llega
    // en diferido y cambia el alto del título), rotación y resize.
    const syncHeroHeight = () => {
      hero.style.setProperty("--hero-h", `${hero.offsetHeight}px`);
    };
    syncHeroHeight();
    hero.classList.add("is-hero-sticky");
    new ResizeObserver(syncHeroHeight).observe(hero);

    (async () => {
      const [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
      ]);
      gsap.registerPlugin(ScrollTrigger);
      // Que mostrar/ocultar la barra de direcciones en mobile no dispare un
      // refresh completo a mitad del scroll.
      ScrollTrigger.config({ ignoreMobileResize: true });

      const fade = gsap
        .timeline({ paused: true })
        .to(hero, { autoAlpha: 0, scale: 0.92, y: -60, ease: "none" });

      const trigger = ScrollTrigger.create({
        trigger: overlapWrapper,
        start: "top bottom",
        end: "top top",
        scrub: 0.35,
        animation: fade,
      });

      // Las fuentes cargan en diferido (Layout.astro): cuando llegan, el
      // alto del hero cambia y con él la posición del wrapper — re-medir.
      document.fonts?.ready.then(() => ScrollTrigger.refresh());

      window.addEventListener(
        "pagehide",
        () => {
          trigger.kill();
        },
        { once: true },
      );
    })();
  }
</script>
