---
// Trackea como evento GA4 "click_whatsapp" cualquier link marcado con
// data-ga-whatsapp. Un solo listener delegado a nivel document — cualquier
// CTA nuevo que agregue el atributo se trackea automático sin tocar este
// archivo.
//
// Alcance: CTAs genéricos con <a data-ga-whatsapp> estático (nav, footer,
// CTA final de home/servicios, portafolio, eventos, proyecto) + todos los
// botones de planes/packs de PlanCard (crece solo con el catálogo, sin
// tocar este archivo — no vale la pena mantener la cuenta exacta acá).
//
// El formulario de #contacto y el modal de #sueltos en /servicios NO usan
// este listener delegado porque arman el link de WhatsApp dinámicamente por
// JS (no son un <a href> estático en el momento del click) — cada uno
// dispara su propio gtag("event", "click_whatsapp", ...) al hacer submit,
// ver ContactSection.astro y SinglesSection.astro.
---

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const link = target?.closest<HTMLElement>("[data-ga-whatsapp]");
    if (!link) return;

    const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void })
      .gtag;
    if (typeof gtag !== "function") return;

    gtag("event", "click_whatsapp", {
      cta_location: link.dataset.gaLocation || "unknown",
      cta_label: link.dataset.gaLabel || "",
      cta_value: link.dataset.gaValue || undefined,
    });
  });
</script>
