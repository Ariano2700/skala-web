---
import { FiChevronDown, FiArrowUpRight } from "react-icons/fi";
import type { NavLink } from "../../data/navigation";

interface Props {
  links: NavLink[];
  isMobile: boolean;
  depth?: number;
}

const isHome = Astro.url.pathname === "/";
const resolveHref = (href: string) =>
  href.startsWith("#") && !isHome ? `/${href}` : href;

const { isMobile, links, depth = 0 } = Astro.props as Props;
---

{
  links.map((item) => (
    <div
      class={isMobile ? "mobile-submenu" : "desktop-submenu"}
      data-depth={depth}
    >
      {item.subLinks && item.subLinks.length > 0 ? (
        <>
          {isMobile ? (
            <div class="mobile-submenu-wrapper flex items-center w-full">
              <a
                href={resolveHref(item.href)}
                title={item.label}
                aria-label={item.label}
                class="group flex-1 flex items-center justify-between rounded-2xl border border-transparent bg-white/3 px-4 py-4 text-skala-muted transition duration-200 hover:border-skala-accent/24 hover:bg-skala-accent/6 hover:text-skala-text focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-x-0"
              >
                <span class="text-sm font-bold tracking-[0.08em]">
                  {item.label}
                </span>
                <FiArrowUpRight
                  className="h-4 w-4 opacity-0 transition duration-200 group-hover:translate-x-0.5 group-hover:translate-y-[-0.5px] group-hover:opacity-100"
                  aria-hidden="true"
                />
              </a>
              <button
                type="button"
                class="mobile-submenu-toggle shrink-0 ml-2 p-2 rounded-full text-skala-muted hover:text-skala-text hover:bg-white/10 transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-skala-accent/60"
                aria-expanded="false"
                aria-controls={`submenu-${item.href.replace(/[^a-zA-Z0-9]/g, "-")}-${depth}`}
                data-submenu-toggle
                aria-label={`Expandir submenú ${item.label}`}
              >
                <FiChevronDown
                  className="h-5 w-5 opacity-50 transition-transform duration-200"
                  aria-hidden="true"
                />
              </button>
            </div>
          ) : (
            <a
              href={resolveHref(item.href)}
              title={item.label}
              aria-label={item.label}
              aria-haspopup="true"
              aria-expanded="false"
              class="group/link desktop-submenu-trigger relative flex w-full items-center justify-between gap-1 whitespace-nowrap overflow-hidden rounded-2xl px-4 py-2 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-skala-muted transition duration-200 hover:bg-white/06 hover:text-skala-text focus-visible:ring-2 focus-visible:ring-skala-accent/60"
            >
              <span>{item.label}</span>
              <FiChevronDown
                className="shrink-0 ml-1 h-3 w-3 opacity-50 transition-transform duration-200 group-hover/link:opacity-100 group-hover/link:rotate-180"
                aria-hidden="true"
              />
              <span class="absolute inset-x-4 bottom-1.5 h-px scale-x-0 bg-skala-accent transition-transform duration-300 group-hover/link:scale-x-100" />
            </a>
          )}
          <div
            id={`submenu-${item.href.replace(/[^a-zA-Z0-9]/g, "-")}-${depth}`}
            class={
              isMobile
                ? "mobile-submenu-content overflow-hidden transition-all duration-200 ml-4 mt-2 border-l border-white/10 pl-3 flex flex-col gap-3"
                : "desktop-submenu-content absolute left-0 top-full z-50 mt-2 hidden min-w-50 rounded-2xl border border-white/12 bg-[#04142e]/96 py-2 shadow-[0_28px_80px_rgba(0,0,0,0.38)] backdrop-blur-xl"
            }
            role={isMobile ? "region" : "menu"}
            aria-label={item.label}
          >
            <Astro.self
              links={
                isMobile
                  ? [{ label: item.label, href: item.href }, ...item.subLinks]
                  : item.subLinks
              }
              isMobile={isMobile}
              depth={depth + 1}
            />{" "}
          </div>
        </>
      ) : isMobile ? (
        <a
          href={resolveHref(item.href)}
          title={item.label}
          aria-label={item.label}
          class="group flex w-full items-center justify-between rounded-2xl border border-transparent bg-white/3 px-4 py-4 text-skala-muted transition duration-200 hover:-translate-x-0.5 hover:border-skala-accent/24 hover:bg-skala-accent/6 hover:text-skala-text focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-x-0"
          style={`padding-left: ${depth * 16 + 16}px;`}
        >
          <span class="text-sm font-bold tracking-[0.08em]">{item.label}</span>
          <FiArrowUpRight
            className="h-4 w-4 opacity-0 transition duration-200 group-hover:translate-x-0.5 group-hover:translate-y-[-0.5px] group-hover:opacity-100"
            aria-hidden="true"
          />
        </a>
      ) : (
        <a
          href={resolveHref(item.href)}
          title={item.label}
          aria-label={item.label}
          class="group/link relative flex w-full items-center justify-between gap-1 whitespace-nowrap overflow-hidden rounded-2xl px-4 py-2 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-skala-muted transition duration-200 hover:bg-white/06 hover:text-skala-text focus-visible:ring-2 focus-visible:ring-skala-accent/60"
        >
          <span>{item.label}</span>
          <span class="absolute inset-x-4 bottom-1.5 h-px scale-x-0 bg-skala-accent transition-transform duration-300 group-hover/link:scale-x-100" />
        </a>
      )}
    </div>
  ))
}

<style>
  /* Mobile submenu animation for proper open/close */
  .mobile-submenu-content {
    max-height: 0;
    opacity: 0;
    transition: max-height 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease-out;
  }

  .mobile-submenu-content.open {
    max-height: 500px;
    opacity: 1;
  }

  /* Chevron rotation for mobile */
  .mobile-submenu-toggle[data-open] FiChevronDown {
    transform: rotate(180deg);
  }
</style>
