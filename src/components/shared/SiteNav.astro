---
import { FiArrowUpRight, FiMenu, FiX, FiChevronDown } from "react-icons/fi";
import Logotype from "../../icons/Logotype.astro";
import { CONTACT_DATA } from "../../data/contact_data";
import { buildDynamicNavLinks, getStaticNavLinks } from "../../data/navigation-dynamic";
import RenderSubLinks from "./RenderSubLinks.astro";

// En la home las anclas funcionan directo (#servicios). En otras páginas
// hay que volver a la home y luego hacer scroll a la sección (/#servicios).
const isHome = Astro.url.pathname === "/";
const resolveHref = (href: string) =>
  href.startsWith("#") && !isHome ? `/${href}` : href;

// Use dynamic nav links for SSR, static for SSG fallback
const navLinks = Astro.props.isStatic ? getStaticNavLinks() : await buildDynamicNavLinks();
---

<header
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  data-reveal
  data-scrolled
>
  <div
    class="site-nav-bg pointer-events-none absolute inset-x-0 top-0 h-16 border-b border-transparent transition-colors duration-300"
  >
  </div>

  <div
    class="relative mx-auto flex h-16 items-center justify-between md:justify-around gap-3 px-4 md:px-12"
  >
    <a
      href={isHome ? "#top" : "/"}
      title="Ir al inicio"
      aria-label="Ir al inicio"
      class="group inline-flex min-h-12 items-center gap-3 rounded-full px-3 py-2 outline-none transition duration-200 hover:-translate-y-px focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-y-px"
    >
      <span
        class="text-skala-accent! hover:text-skala-text! shadow transition-colors duration-200"
      >
        <Logotype class="size-24" />
      </span>
    </a>

    <nav
      class="hidden items-center gap-1 rounded-full border border-white/8 bg-[rgba(4,20,46,0.72)] p-1 xl:inline-flex"
      aria-label="Secciones principales"
    >
      <div class="relative flex items-center gap-1" data-desktop-nav>
        {
          navLinks.map((item) => (
            <div class="relative" data-nav-item>
              {item.subLinks && item.subLinks.length > 0 ? (
                <>
                  <a
                    href={resolveHref(item.href)}
                    title={item.label}
                    aria-label={item.label}
                    aria-haspopup="true"
                    aria-expanded="false"
                    class="group/link desktop-submenu-trigger relative flex w-full items-center justify-between gap-1 whitespace-nowrap overflow-hidden rounded-2xl px-4 py-2 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-skala-muted transition duration-200 hover:bg-white/06 hover:text-skala-text focus-visible:ring-2 focus-visible:ring-skala-accent/60"
                  >
                    <span>{item.label}</span>
                    <FiChevronDown
                      className="shrink-0 ml-1 h-3 w-3 opacity-50 transition-transform duration-200 group-hover/link:opacity-100 group-hover/link:rotate-180"
                      aria-hidden="true"
                    />
                    <span class="absolute inset-x-4 bottom-1.5 h-px scale-x-0 bg-skala-accent transition-transform duration-300 group-hover/link:scale-x-100" />
                  </a>
                  <div
                    class="desktop-submenu-content absolute left-0 top-full z-50 mt-2 hidden min-w-50 rounded-2xl border border-white/12 bg-[#04142e]/96 py-2 shadow-[0_28px_80px_rgba(0,0,0,0.38)] backdrop-blur-xl"
                    role="menu"
                    aria-label={item.label}
                  >
                    <RenderSubLinks links={item.subLinks} isMobile={false} />
                  </div>
                </>
              ) : (
                <a
                  href={resolveHref(item.href)}
                  title={item.label}
                  aria-label={item.label}
                  class="group/link relative flex w-full items-center justify-between gap-1 whitespace-nowrap overflow-hidden rounded-2xl px-4 py-2 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-skala-muted transition duration-200 hover:bg-white/06 hover:text-skala-text focus-visible:ring-2 focus-visible:ring-skala-accent/60"
                >
                  <span>{item.label}</span>
                  <span class="absolute inset-x-4 bottom-1.5 h-px scale-x-0 bg-skala-accent transition-transform duration-300 group-hover/link:scale-x-100" />
                </a>
              )}
            </div>
          ))
        }
      </div>
    </nav>

    <a
      href={CONTACT_DATA.WHATSAPP_LINK(
        "Hola, quiero saber más sobre sus servicios de agencia y productora.",
      )}
      title="Contáctanos por WhatsApp"
      aria-label="Contáctanos por WhatsApp"
      target="_blank"
      rel="noopener noreferrer"
      class="group hidden items-center gap-2 rounded-full border border-skala-border-strong bg-skala-accent px-4 py-3 text-[0.72rem] font-bold uppercase tracking-[0.14em] text-skala-text-secondary! shadow-[0_14px_32px_rgba(92,216,252,0.18)] transition duration-200 hover:-translate-y-px hover:bg-skala-accent/90 focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-y-px xl:inline-flex"
    >
      Agenda <FiArrowUpRight
        aria-hidden="true"
        className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 size-4"
      />
    </a>

    <button
      type="button"
      class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-[rgba(4,20,46,0.72)] text-skala-text transition duration-200 hover:-translate-y-px hover:border-skala-accent/40 hover:bg-skala-accent/8 focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-y-px xl:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <FiMenu className="h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <div
    id="mobile-nav"
    class="fixed inset-x-4 top-19 z-50 hidden overflow-hidden rounded-4xl border border-white/12 bg-[#04142e]/96 p-3 shadow-[0_28px_80px_rgba(0,0,0,0.38)]"
    data-mobile-nav
  >
    <div class="mobile-nav-panel">
      <div
        class="flex items-center justify-between border-b border-white/8 px-3 pb-3"
      >
        <div>
          <p
            class="font-display text-sm font-black tracking-[-0.04em] text-skala-text"
          >
            Navegación
          </p>
          <p class="text-xs text-skala-muted">Explora la experiencia Skala</p>
        </div>
        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-skala-text transition duration-200 hover:bg-skala-accent/8 focus-visible:ring-2 focus-visible:ring-skala-accent/60"
          aria-label="Cerrar menú"
          data-nav-close
        >
          <FiX className="h-5 w-5" aria-hidden="true" />
        </button>
      </div>

      <nav
        class="mobile-nav-links grid gap-2 p-3"
        aria-label="Secciones principales en móvil"
      >
        <RenderSubLinks links={navLinks} isMobile={true} />
      </nav>

      <a
        href={resolveHref("#contacto")}
        title="Contáctanos por WhatsApp"
        aria-label="Contáctanos por WhatsApp"
        class="text-skala-text-secondary! mobile-nav-cta group mx-3 mb-3 flex items-center justify-center gap-2 rounded-full bg-skala-accent px-4 py-4 text-[0.72rem] font-black uppercase tracking-[0.16em] transition duration-200 hover:bg-skala-accent/90 focus-visible:ring-2 focus-visible:ring-skala-accent/60 active:translate-y-px"
      >
        Agenda <FiArrowUpRight
          aria-hidden="true"
          className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>
</header>

<style>
  .site-nav-bg[data-scrolled] {
    background: rgba(4, 20, 46, 0.52);
    border-color: rgba(174, 224, 255, 0.08);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
  }

  /* Las tarjetas del menú móvil son visibles por defecto (no dependen de JS
     para ser clicables). La animación de entrada es solo decorativa. */
  .mobile-nav-panel {
    opacity: 1;
  }
</style>

<script>
  (() => {
    const toggleButton = document.querySelector("[data-nav-toggle]");
    const closeButton = document.querySelector("[data-nav-close]");
    const mobileNav = document.querySelector("[data-mobile-nav]");
    const mobileLinks = mobileNav?.querySelectorAll<HTMLElement>(
      ".mobile-nav-links a, .mobile-submenu-content a",
    );
    const mobileCta = mobileNav?.querySelector<HTMLElement>(".mobile-nav-cta");
    let closeTimeout: ReturnType<typeof setTimeout>;
    if (!toggleButton || !mobileNav) {
      return;
    }

    const setMenuState = (open: boolean) => {
      clearTimeout(closeTimeout);
      mobileNav.classList.toggle("hidden", false);

      if (open) {
        mobileNav.classList.remove("animate-[mobileNavOut_180ms_ease-in_both]");
        mobileNav.classList.add("animate-[mobileNavIn_220ms_ease-out_both]");
        mobileNav.querySelector<HTMLElement>(".mobile-nav-panel")?.animate(
          [
            { opacity: 0, transform: "translate3d(0, 12px, 0) scale(0.98)" },
            { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)" },
          ],
          {
            duration: 220,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "forwards",
          },
        );

        mobileLinks?.forEach((link, index) => {
          link.animate(
            [
              { opacity: 0, transform: "translate3d(0, 10px, 0)" },
              { opacity: 1, transform: "translate3d(0, 0, 0)" },
            ],
            {
              duration: 260,
              delay: 90 + index * 45,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              fill: "forwards",
            },
          );
        });

        mobileCta?.animate(
          [
            { opacity: 0, transform: "translate3d(0, 10px, 0)" },
            { opacity: 1, transform: "translate3d(0, 0, 0)" },
          ],
          {
            duration: 260,
            delay: 90 + (mobileLinks?.length ?? 0) * 45,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "forwards",
          },
        );
      } else {
        mobileNav.classList.remove("animate-[mobileNavIn_220ms_ease-out_both]");
        mobileNav.classList.add("animate-[mobileNavOut_180ms_ease-in_both]");
        mobileNav.querySelector<HTMLElement>(".mobile-nav-panel")?.animate(
          [
            { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)" },
            { opacity: 0, transform: "translate3d(0, 8px, 0) scale(0.98)" },
          ],
          {
            duration: 180,
            easing: "cubic-bezier(0.55, 0, 0.2, 1)",
            fill: "forwards",
          },
        );

        closeTimeout = setTimeout(() => {
          mobileNav.classList.add("hidden");
        }, 190);
      }

      document.body.classList.toggle("overflow-hidden", open);
      toggleButton.setAttribute("aria-expanded", String(open));
      toggleButton.setAttribute(
        "aria-label",
        open ? "Cerrar menú" : "Abrir menú",
      );
    };

    const nav = document.querySelector<HTMLElement>("[data-reveal]");
    const navBackground = nav?.querySelector<HTMLElement>(".site-nav-bg");
    const updateNavBackground = () => {
      navBackground?.toggleAttribute("data-scrolled", window.scrollY > 12);
    };

    updateNavBackground();
    window.addEventListener("scroll", updateNavBackground, { passive: true });

    toggleButton.addEventListener("click", () => {
      setMenuState(mobileNav.classList.contains("hidden"));
    });

    closeButton?.addEventListener("click", () => setMenuState(false));

    // Close mobile menu when clicking any link (including submenu links)
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuState(false));
    });

    // Mobile submenu toggle handling
    const mobileSubmenuToggles = mobileNav.querySelectorAll(
      "[data-submenu-toggle]",
    );
    mobileSubmenuToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        // Find the submenu content - try by ID first, then by DOM structure
        const contentId = toggle.getAttribute("aria-controls");
        let content = contentId ? document.getElementById(contentId) : null;
        // Fallback: content is next sibling of the wrapper (parent of button)
        if (!content) {
          const wrapper = toggle.closest(".mobile-submenu-wrapper");
          content = wrapper?.nextElementSibling as HTMLElement | null;
        }
        if (!content) return;
        
        if (!isOpen) {
          content.classList.remove("hidden");
          // Force reflow for animation
          content.offsetHeight;
          content.classList.add("open");
        } else {
          content.classList.remove("open");
          content.addEventListener(
            "transitionend",
            () => {
              if (!content.classList.contains("open")) {
                content.classList.add("hidden");
              }
            },
            { once: true },
          );
        }
        toggle.setAttribute("aria-expanded", String(!isOpen));
        toggle.toggleAttribute("data-open", !isOpen);
      });
    });

    // Desktop submenu hover handling
    const desktopNavItems = document.querySelectorAll("[data-nav-item]");
    desktopNavItems.forEach((item) => {
      const trigger = item.querySelector<HTMLAnchorElement>(
        ".desktop-submenu-trigger",
      );
      const content = item.querySelector<HTMLElement>(
        ".desktop-submenu-content",
      );

      if (trigger && content) {
        let hideTimeout: ReturnType<typeof setTimeout>;

        const showSubmenu = () => {
          clearTimeout(hideTimeout);
          content.classList.remove("hidden");
        };

        const hideSubmenu = () => {
          hideTimeout = setTimeout(() => {
            content.classList.add("hidden");
          }, 150);
        };

        item.addEventListener("mouseenter", showSubmenu);
        item.addEventListener("mouseleave", hideSubmenu);

        // Keyboard support
        trigger.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            showSubmenu();
            content.querySelector<HTMLAnchorElement>("a, button")?.focus();
          } else if (e.key === "Escape") {
            hideSubmenu();
            trigger.focus();
          }
        });

        content.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key === "Escape") {
            hideSubmenu();
            trigger.focus();
          }
        });
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuState(false);
    });
  })();
</script>
