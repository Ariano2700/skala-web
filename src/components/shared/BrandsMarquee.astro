---
// Marquesina de logos de marcas/clientes, reutilizable en cualquier página.
// Reusa el keyframe `marquee` (linear, infinito) ya definido en
// global.css — el mismo truco de MarqueeStrip.astro: la pista se duplica
// una vez y se traslada exactamente -50%, así el loop es perfectamente
// continuo sin importar cuántas marcas haya.
//
// Los logos vienen en color sobre fondo propio (algunos oscuros, algunos
// muy claros) — para que cualquier logo, presente o futuro, se vea bien
// sobre el fondo oscuro del sitio, se normalizan a una silueta blanca
// (grayscale + brightness-0 + invert) en reposo, y muestran su color real
// al hacer hover. Es el mismo patrón que usan Linear/Stripe en sus tiras
// de "clientes que confían en nosotros".
import { brands } from "../../data/brands";

interface Props {
  title?: string;
  subtitle?: string;
  // Sólo la portada la activa: convierte la sección en el panel que se
  // sobrepone al hero al hacer scroll (ver HeroOverlapReveal.astro). El resto
  // de páginas sigue usando el componente tal cual, sin este tratamiento.
  overlap?: boolean;
}

const {
  title = "Marcas que confían en nosotros",
  subtitle = "Conoce a los negocios que ya confiaron en nuestro trabajo.",
  overlap = false,
} = Astro.props;

// Repetimos la lista base varias veces por mitad para que la tira se sienta
// llena incluso con pocos logos cargados; el loop sigue siendo perfecto
// porque ambas mitades son idénticas entre sí.
const REPEAT = 4;
const half = Array.from({ length: REPEAT }, () => brands).flat();
const track = [...half, ...half];
---

<section
  class:list={[
    "relative z-10 mx-auto w-full max-w-360 px-5 py-14 md:px-12 md:py-20",
    overlap && "hero-overlap-panel",
  ]}
  aria-label={title}
  data-reveal={!overlap}
  data-hero-overlap={overlap}
>
  <div class="mb-10 text-center">
    <h2
      class="m-0 font-display text-lg font-black tracking-[-0.02em] text-skala-text md:text-2xl"
    >
      {title}
    </h2>
    <p class="mx-auto mt-2.5 max-w-[46ch] text-sm leading-6 text-skala-muted md:text-base">
      {subtitle}
    </p>
  </div>

  <div class="brand-marquee-mask relative overflow-hidden">
    <div
      class="flex w-max items-center gap-14 animate-[marquee_40s_linear_infinite] sm:gap-20"
      data-brand-track
    >
      {
        track.map((brand) => (
          <a
            href={brand.url}
            target="_blank"
            rel="noopener noreferrer"
            title={brand.name}
            aria-label={brand.name}
            class="flex h-14 w-36 shrink-0 items-center justify-center sm:h-20 sm:w-40"
          >
            <img
              src={brand.logo}
              alt={brand.name}
              loading="lazy"
              decoding="async"
              class="max-h-full max-w-full object-contain opacity-55 grayscale brightness-0 invert transition duration-300 hover:opacity-100 hover:filter-none"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .brand-marquee-mask {
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }

  /* Pausa el recorrido al pasar el mouse: da tiempo a mirar un logo puntual. */
  [data-brand-track]:hover {
    animation-play-state: paused;
  }

  /*
    Panel que se sobrepone al hero de la portada (HeroOverlapReveal.astro
    le da la posición inicial vía transform; aquí sólo el aspecto de "tarjeta"
    que hace legible el efecto: esquinas redondeadas arriba, superficie propia
    y una sombra que la despega del hero que va desapareciendo debajo).
  */
  .hero-overlap-panel {
    position: relative;
    z-index: 2;
    background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
  }

  .hero-overlap-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(92, 216, 252, 0.45),
      transparent
    );
  }

  @media (min-width: 768px) {
    .hero-overlap-panel {
      border-radius: 3rem 3rem 0 0;
    }
  }
</style>
